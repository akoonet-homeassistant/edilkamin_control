  "services": {
    "add_profile": {
      "name": "Add a schedule",
      "description": "Creates a schedule (10 at most).",
      "fields": {
        "entry_id": {
          "name": "Stove",
          "description": "Edilkamin Control entry (optional when there is only one)."
        },
        "name": {
          "name": "Name",
          "description": "Displayed name."
        },
        "start": {
          "name": "Start",
          "description": "Start time."
        },
        "end": {
          "name": "End",
          "description": "End time (same as start: all day)."
        },
        "days": {
          "name": "Days",
          "description": "Days of the week (0 = Monday)."
        },
        "setpoint": {
          "name": "Setpoint",
          "description": "Target temperature."
        },
        "mode": {
          "name": "Mode",
          "description": "Run or Standby."
        },
        "power": {
          "name": "Power",
          "description": "Auto or Man. P1 to P5."
        },
        "fan1": {
          "name": "Fan 1",
          "description": "Stove fan 1 value."
        },
        "fan2": {
          "name": "Fan 2",
          "description": "Stove fan 2 value."
        },
        "relax": {
          "name": "Silent",
          "description": "Relax mode."
        },
        "active": {
          "name": "Enabled",
          "description": "Schedule enabled."
        }
      }
    },
    "remove_profile": {
      "name": "Remove a schedule",
      "description": "Removes a schedule and its entities.",
      "fields": {
        "entry_id": {
          "name": "Stove",
          "description": "Edilkamin Control entry."
        },
        "profile": {
          "name": "Schedule",
          "description": "Position in the list (1 = first)."
        }
      }
    },
    "set_profile_days": {
      "name": "Schedule days",
      "description": "Sets the days of the week of a schedule.",
      "fields": {
        "entry_id": {
          "name": "Stove",
          "description": "Edilkamin Control entry."
        },
        "profile": {
          "name": "Schedule",
          "description": "Position in the list."
        },
        "days": {
          "name": "Days",
          "description": "Days of the week (0 = Monday)."
        }
      }
    },
    "move_profile": {
      "name": "Move a schedule",
      "description": "Changes the position of a schedule (the first wins when they overlap).",
      "fields": {
        "entry_id": {
          "name": "Stove",
          "description": "Edilkamin Control entry."
        },
        "profile": {
          "name": "Schedule",
          "description": "Current position."
        },
        "position": {
          "name": "New position",
          "description": "Wanted position."
        }
      }
    },
    "reservoir_filled": {
      "name": "Hopper refilled",
      "description": "Resets the hopper burn-time counter.",
      "fields": {
        "entry_id": {
          "name": "Stove",
          "description": "Edilkamin Control entry."
        }
      }
    },
    "publish_schedule": {
      "name": "Send the fallback schedule",
      "description": "Publishes the fallback schedule to the ESP32 now.",
      "fields": {
        "entry_id": {
          "name": "Stove",
          "description": "Edilkamin Control entry."
        }
      }
    }
  }
